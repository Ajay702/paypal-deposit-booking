# Leave PAYPAL_CLIENT_ID empty (or DEMO=true) to run with simulated PayPal.
DEMO=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox (default) or live
PAYPAL_ENV=sandbox

PORT=3000
BASE_URL=http://localhost:3000
ADMIN_PASSWORD=change-me

# Optional: send real emails. Without it, emails are written to ./outbox
# e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=bookings@yoursalon.com

# White-label: point at another business file to re-skin for a different client
BUSINESS_FILE=business.json
DATA_DIR=data
